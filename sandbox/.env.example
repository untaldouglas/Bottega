# Valores sintéticos/no ejecutables para el sandbox I3; nunca usar en producción.
# El .env local debe ser modo 600 y no se versiona (está en .gitignore).
# Los digests de imagen (base, mariadb, redis) van fijados en compose.yaml.
I3_HTTP_PORT=18753
I3_DB_PASSWORD=synthetic-i3-db-password-0000
MARIADB_ROOT_PASSWORD=synthetic-i3-db-password-0000
MARIADB_PASSWORD=synthetic-i3-db-password-0000
I3_SYNTHETIC_SECRET=synthetic-only-not-a-credential
